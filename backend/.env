# PostgreSQL settings
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DATABASE=knowledge_base_rag

# JWT settings
JWT_SECRET_KEY=your-super-secret-key-change-this-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# RAG Settings
RAG_ENABLED=true
RAG_EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
RAG_RERANK_MODEL=BAAI/bge-reranker-base
RAG_LLM_MODEL=Qwen/Qwen2.5-Coder-7B-Instruct
RAG_LLM_API_URL=http://host.docker.internal:18000/v1
RAG_LLM_API_KEY=EMPTY
RAG_LLM_TIMEOUT=30.0
RAG_TOP_K=5
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=200
RAG_CHROMA_PATH=./data/chromadb
RAG_CHROMA_COLLECTION=docs_fast

# Outlier Detection Settings
OUTLIER_DETECTION_ENABLED=true
OUTLIER_CLASSIFIER_PATH=./models/pytorch_topic_classifier.joblib
OUTLIER_REJECT_OFF_TOPIC=false

# Code Executor Settings
# Внутри docker backend обращается к сервису по имени, а не localhost
CODE_EXECUTOR_URL=http://code-executor:8002/execute
RAG_LLM_MODEL_GENERATION=synth-v2
