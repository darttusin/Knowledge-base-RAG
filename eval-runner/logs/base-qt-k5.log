\n\\n```python\\nimport os\\nimport pandas as pd\\nfrom torchvision.io import read_image\\nfrom torchvision import transforms\\nfrom torch.utils.data import Dataset\\n\\nclass CustomImageDataset(Dataset):\\n    def __init__(self, annotations_file, img_dir, transform=None, target_transform=None):\\n        self.img_labels = pd.read_csv(annotations_file, sep=\';\')\\n        self.img_dir = img_dir\\n        self.transform = transform\\n        self.target_transform = target_transform\\n\\n    def __len__(self):\\n        return len(self.img_labels)\\n\\n    def __getitem__(self, idx):\\n        img_path = os.path.join(self.img_dir, self.img_labels.iloc[idx, 0][0:9] + \'.tar\', self.img_labels.iloc[idx, 0])\\n        image = read_image(img_path)\\n        \\n        # Check if the image has three channels\\n        if image.shape[0] != 3:\\n            print(f\\"Image {img_path} does not have three channels. Shape: {image.shape}\\")\\n            # Optionally, convert to RGB if necessary\\n            image = transforms.ToPILImage()(image)\\n            image = transforms.ToTensor()(image.convert(\'RGB\'))\\n        \\n        transf = transforms.Resize((224, 224))\\n        image = transf(image)\\n        \\n        label = self.img_labels.iloc[idx, 1]\\n        if self.transform:\\n            image = self.transform(image)\\n        if self.target_transform:\\n            label = self.target_transform(label)\\n        \\n        return image, label\\n```\\n\\n### Where to Read More\\n- [PyTorch Documentation on `read_image`](https://pytorch.org/vision/stable/generated/torchvision.io.read_image.html)\\n- [PyTorch Documentation on `transforms.Resize`](https://pytorch.org/vision/stable/generated/torchvision.transforms.Resize.html)\\n- [PyTorch Documentation on `transforms.ToPILImage`](https://pytorch.org/vision/stable/generated/torchvision.transforms.ToPILImage.html)\\n- [PyTorch Documentation on `transforms.ToTensor`](https://pytorch.org/vision/stable/generated/torchvision.transforms.ToTensor.html)"\n}\nOutput: ', 'role': 'user'}], 'model': 'Qwen/Qwen2.5-Coder-7B-Instruct', 'n': 1, 'stream': False, 'temperature': 0.01}}
