# PostgreSQL settings
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DATABASE=knowledge_base_rag

# JWT settings
JWT_SECRET_KEY=your-super-secret-key-change-this-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# RAG Settings
RAG_ENABLED=true
RAG_EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
RAG_RERANK_MODEL=BAAI/bge-reranker-base
RAG_LLM_MODEL=TechxGenus/c4ai-command-r-v01-AWQ
RAG_LLM_API_URL=http://localhost:8003/v1
RAG_LLM_API_KEY=
RAG_TOP_K=5
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=200
RAG_CHROMA_PATH=../data/chromadb
RAG_CHROMA_COLLECTION=docs_fast

# Outlier Detection Settings
OUTLIER_DETECTION_ENABLED=true
OUTLIER_CLASSIFIER_PATH=./models/pytorch_classifier.joblib
OUTLIER_REJECT_OFF_TOPIC=false

# Code Executor Settings
CODE_EXECUTOR_URL=http://localhost:8002/execute
