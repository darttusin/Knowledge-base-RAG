# Root .env template for docker-compose.yml.
#
# Copy this file to .env and replace every placeholder before starting Compose.
# Do not commit .env. Only variables referenced by docker-compose.yml are read
# from this root file; standalone backend/rag/parser/bot settings are documented
# in README.md and their Settings classes.

# PostgreSQL container and backend connection.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-a-local-development-password
POSTGRES_DATABASE=knowledge_base_rag

# The backend intentionally rejects this known placeholder during lifespan.
# Replace it with a long random value; never expose the real value in logs/docs.
JWT_SECRET_KEY=your-super-secret-key-change-this-in-production

# Compose does not include a generator. Keep false for CRUD-only development;
# enable only after configuring a reachable OpenAI-compatible endpoint.
RAG_ENABLED=false
RAG_LLM_API_URL=

# EMPTY is suitable only for a local endpoint that ignores authentication.
# For a cloud endpoint, inject the real key from a private secret store.
RAG_LLM_API_KEY=EMPTY

# Optional token for private/gated Hugging Face model downloads.
HF_TOKEN=

# docker-compose.yml currently fixes POSTGRES_HOST=postgres,
# POSTGRES_PORT=5432, JWT_ALGORITHM=HS256 and NEXT_PUBLIC_API_URL directly.
# Other backend knobs are not forwarded from this root file unless Compose is
# changed explicitly; see backend/settings.py and README.md.
